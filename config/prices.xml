    <!--
        requireHardDifficulty  only apply on HARD; other difficulties would multiply these prices by 1.8 / 3.
        keepBuyPrices          buying stations and consumption costs keep the original price of changed fillTypes.
        rescaleHistory         rescale the saved price history (economy.xml) to the new prices.
        dumpOnStart            write modSettings/FS25_SellPrices/priceDump.csv on every savegame start.
    -->
    <settings requireHardDifficulty="true" keepBuyPrices="true" rescaleHistory="true" dumpOnStart="true"/>

